{
  "name": "lighthouse-dispatch",
  "version": "2.0.0",
  "private": true,
  "description": "Rental workflow app for Lighthouse Film Service (v2, single-page Claude Artifact)",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.js && next build",
    "build:artifact": "node scripts/build.js",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/logic.test.js tests/parity.test.js tests/docs.test.js",
    "test:ui": "node --test tests/ui.test.js",
    "test:api": "node --test tests/api.test.js",
    "db:start": "node scripts/db.js start",
    "db:stop": "node scripts/db.js stop",
    "db:migrate": "node scripts/migrate.js",
    "db:import": "node scripts/import.js",
    "test:db": "node --test --test-concurrency=1 tests/db.test.js",
    "test:orders": "node --test --test-concurrency=1 tests/orders-api.test.js",
    "test:e2e": "node e2e/db.js setup && playwright test; s=$?; node e2e/db.js teardown; exit $s",
    "test:master": "node --test --test-concurrency=1 tests/master-api.test.js",
    "test:slice4": "node --test --test-concurrency=1 tests/slice4-api.test.js",
    "test:crewids": "node --test --test-concurrency=1 tests/crewids-api.test.js",
    "test:backup": "node --test --test-concurrency=1 tests/backup.test.js",
    "backup": "node scripts/backup.js create",
    "backup:verify": "node scripts/backup.js verify",
    "test:auth": "node --test --test-concurrency=1 tests/auth.test.js",
    "test:trial": "node --test --test-concurrency=1 tests/trial.test.js",
    "trial": "node scripts/trial.js",
    "test:notify": "node --test --test-concurrency=1 tests/notify.test.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "jsdom": "26.1.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "jose": "6.2.12",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-x64@17.10.0-beta.17": true
  }
}
